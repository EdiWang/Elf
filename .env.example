ELF_IMAGE=ediwang/elf:latest
ELF_POSTGRES_USER=elf
ELF_POSTGRES_PASSWORD=replace-with-a-strong-database-password
ELF_POSTGRES_DB=elf
ELF_POSTGRES_PORT=5432
ELF_APP_PORT=8080
ELF_API_PORT=8080
ELF_ADMIN_PORT=8081
ELF_AUTH_PROVIDER=Local
ELF_ADMIN_USERNAME=admin
ELF_ADMIN_PASSWORD=replace-with-a-strong-admin-password
ELF_FORWARDER_BASE_URL=http://localhost:8080
ELF_DEFAULT_REDIRECTION_URL=https://edi.wang
ELF_REDIS_CONNECTION=
ELF_ENABLE_TRACKING=true
ELF_ALLOW_SELF_REDIRECTION=false
ELF_OIDC_AUTHORITY=https://identity.example.com/
ELF_OIDC_CLIENT_ID=replace-with-client-id
ELF_OIDC_CLIENT_SECRET=replace-with-client-secret
Authentication__OpenIdConnect__AllowedSubjects__0=replace-with-admin-subject
