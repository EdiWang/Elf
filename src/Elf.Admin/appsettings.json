{
  "Database": {
    "Provider": "SqlServer"
  },
  "ConnectionStrings": {
    "ElfDatabase": "Server=(localdb)\\MSSQLLocalDB;Database=elf;Trusted_Connection=True;",
    "RedisConnection": ""
  },
  "ForwardedHeaders": {
    "Enabled": true,
    "HeaderName": "",
    "KnownProxies": []
  },
  "DefaultRedirectionUrl": "https://edi.wang",
  "FeatureManagement": {
    "AllowSelfRedirection": false,
    "EnableTracking": true
  },
  "RateLimit": {
    "AutoReplenishment": true,
    "PermitLimit": 5,
    "WindowSeconds": 1,
    "QueueLimit": 0
  },
  "Authentication": {
    "Provider": "Local",
    "Local": {
      "BootstrapUsername": "admin",
      "BootstrapPassword": ""
    },
    "Totp": {
      "Enabled": true,
      "Issuer": "Elf"
    },
    "OpenIdConnect": {
      "Authority": "",
      "ClientId": "",
      "CallbackPath": "/signin-oidc",
      "SignedOutCallbackPath": "/signout-callback-oidc",
      "NameClaimType": "name",
      "Scopes": [ "openid", "profile", "email" ],
      "AllowedSubjects": []
    }
  },
  "ForwarderBaseUrl": "https://go.edi.wang",
  "TopClientTypes": 5,
  "LinkTrackingCleanup": {
    "RetentionDays": 365
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
